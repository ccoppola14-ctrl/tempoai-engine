generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OWNER
  MANAGER
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String
  name              String
  role              UserRole      @default(OWNER)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  resetToken        String?
  resetTokenExpiry  DateTime?
  emailVerified     Boolean       @default(false)
  verificationToken String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  assignedLocations UserLocation[]
}

model UserLocation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, locationId])
}

model Organization {
  id        String     @id @default(uuid())
  name      String
  isDemo    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]
  users     User[]
}

model Location {
  id                   String                @id @default(uuid())
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id])
  name                 String
  address              String
  lat                  Float
  lng                  Float
  timezone             String                @default("America/New_York")
  squareMerchantId     String?
  squareAccessToken    String?
  cloverMerchantId     String?
  cloverApiToken       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  menuItems            MenuItem[]
  orders               Order[]
  weatherSnapshots     WeatherSnapshot[]
  aiPatterns           AIPattern[]
  recommendations      Recommendation[]
  syncLogs             SyncLog[]
  alerts               Alert[]
  dailySummaries       DailySummary[]
  contactEmail         String?
  assignedUsers        UserLocation[]
  staffShifts          StaffShift[]
  laborRecommendations LaborRecommendation[]
  laborTargets         LaborTarget[]
}

model MenuItem {
  id              String           @id @default(uuid())
  locationId      String
  location        Location         @relation(fields: [locationId], references: [id])
  squareItemId    String?
  cloverItemId    String?
  name            String
  category        String
  price           Float
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderItems      OrderItem[]
  aiPatterns      AIPattern[]
  recommendations Recommendation[]

  @@unique([locationId, squareItemId])
  @@unique([locationId, cloverItemId])
}

model Order {
  id            String      @id @default(uuid())
  locationId    String
  location      Location    @relation(fields: [locationId], references: [id])
  squareOrderId String?
  cloverOrderId String?
  timestamp     DateTime
  total         Float
  itemCount     Int
  createdAt     DateTime    @default(now())
  orderItems    OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  amount     Float
}

model WeatherSnapshot {
  id            String   @id @default(uuid())
  locationId    String
  location      Location @relation(fields: [locationId], references: [id])
  timestamp     DateTime
  temperature   Float
  conditions    String
  precipitation Float
  humidity      Float
  windSpeed     Float
}

model AIPattern {
  id               String   @id @default(uuid())
  locationId       String
  location         Location @relation(fields: [locationId], references: [id])
  menuItemId       String
  menuItem         MenuItem @relation(fields: [menuItemId], references: [id])
  patternType      String
  triggerCondition String
  baselineSales    Float
  conditionSales   Float
  liftPercent      Float
  confidence       Float
  dataPoints       Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Recommendation {
  id               String    @id @default(uuid())
  locationId       String
  location         Location  @relation(fields: [locationId], references: [id])
  menuItemId       String
  menuItem         MenuItem  @relation(fields: [menuItemId], references: [id])
  type             String
  triggerType      String
  triggerCondition String
  currentlyActive  Boolean   @default(false)
  expectedLift     Float
  confidence       Float
  dataPoints       Int
  message          String
  channels         String
  status           String    @default("active")
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SyncLog {
  id               String   @id @default(uuid())
  locationId       String
  location         Location @relation(fields: [locationId], references: [id])
  source           String
  status           String
  recordsProcessed Int      @default(0)
  error            String?
  timestamp        DateTime @default(now())
}

model CloverMerchant {
  id                   String    @id @default(uuid())
  merchantId           String    @unique
  accessToken          String
  name                 String
  plan                 String    @default("basic")
  active               Boolean   @default(true)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingPlan          String?
  billingStatus        String?
  installedAt          DateTime  @default(now())
  uninstalledAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model SquareMerchant {
  id                   String    @id @default(uuid())
  merchantId           String    @unique
  accessToken          String
  refreshToken         String    @default("")
  expiresAt            DateTime?
  name                 String
  email                String    @default("")
  locations            String    @default("[]")
  plan                 String    @default("basic")
  active               Boolean   @default(true)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingPlan          String?
  billingStatus        String?
  installedAt          DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Alert {
  id             String    @id @default(uuid())
  locationId     String
  location       Location  @relation(fields: [locationId], references: [id])
  type           String
  severity       String
  title          String
  message        String
  data           String    @default("{}")
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
}

model DailySummary {
  id             String   @id @default(uuid())
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  date           String
  totalSales     Float
  orderCount     Int
  topItems       String
  laborCostPct   Float?
  prevWeekSales  Float?
  prevWeekOrders Int?
  changePercent  Float?
  weatherNote    String?
  summary        String
  createdAt      DateTime @default(now())

  @@unique([locationId, date])
}

model Forecast {
  id              String   @id @default(uuid())
  locationId      String
  date            String
  predictedSales  Float
  predictedOrders Int
  confidence      Float
  factors         String   @default("{}")
  createdAt       DateTime @default(now())
}

model IngredientCost {
  id             String   @id @default(uuid())
  locationId     String
  menuItemId     String
  ingredientName String
  cost           Float
  unit           String
  quantity       Float
  updatedAt      DateTime @updatedAt
}

model StaffShift {
  id           String   @id @default(uuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  employeeId   String?
  employeeName String?
  role         String
  startTime    DateTime
  endTime      DateTime
  hourlyRate   Float?
  totalHours   Float
  totalCost    Float?
  source       String
  createdAt    DateTime @default(now())
}

model LaborRecommendation {
  id               String   @id @default(uuid())
  locationId       String
  location         Location @relation(fields: [locationId], references: [id])
  date             String
  daypart          String
  currentStaff     Int
  recommendedStaff Int
  overstaffed      Boolean
  wastedHours      Float
  wastedCost       Float
  missedRevenue    Float?
  confidence       Float
  reasoning        String
  createdAt        DateTime @default(now())
}

model LaborTarget {
  id                  String   @id @default(uuid())
  locationId          String
  location            Location @relation(fields: [locationId], references: [id])
  dayOfWeek           Int
  daypart             String
  targetLaborPct      Float
  minStaff            Int
  maxStaff            Int
  revenuePerStaffHour Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([locationId, dayOfWeek, daypart])
}

model Review {
  id           String    @id @default(uuid())
  locationId   String
  platform     String
  rating       Int
  reviewerName String
  reviewText   String
  responseText String?
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())
}
